From: Utility Muffin Research Kitchen <umrk@users.noreply.github.com>
Subject: [PATCH] Rotate the MLP1 native renderer and menu

Use YabaSanshiro's existing renderer rotation for gameplay. The retro_arena
NanoGUI path bypasses that renderer, so give it a landscape logical canvas and
rotate only its NanoVG commands and pointer coordinates. Omit the decorative
raw-GL About image that bypasses that transform. Screenshot rotation happens
once when the native menu opens; normal gameplay adds no frame copy.
---

diff --git a/yabause/src/nanovg/nanovg_osdcore.c b/yabause/src/nanovg/nanovg_osdcore.c
index 78e7d0c7..29dbc226 100644
--- a/yabause/src/nanovg/nanovg_osdcore.c
+++ b/yabause/src/nanovg/nanovg_osdcore.c
@@ -295,8 +295,18 @@ void OSDNanovgDisplayMessage(OSDMessage_struct * message, pixel_t * buffer, int
   float fontsize = 32.0f;
   int maxlen = 0;
   int i = 0;
+  int framewidth;
+  int frameheight;
+  int rotate90;
 
   VIDCore->GetGlSize(&vidwidth, &vidheight);
+  framewidth = vidwidth;
+  frameheight = vidheight;
+  rotate90 = getenv("YABASANSHIRO_MLP1_ROTATE_90") != NULL;
+  if (rotate90) {
+    vidwidth = frameheight;
+    vidheight = framewidth;
+  }
   
 
   if (message->type == OSDMSG_FPS) {
@@ -322,7 +332,12 @@ void OSDNanovgDisplayMessage(OSDMessage_struct * message, pixel_t * buffer, int
 
 
 
-  nvgBeginFrame(vg, vidwidth, vidheight, 1.0f);
+  nvgBeginFrame(vg, framewidth, frameheight, 1.0f);
+  if (rotate90) {
+    nvgSave(vg);
+    nvgTranslate(vg, 0, frameheight);
+    nvgRotate(vg, -NVG_PI / 2.0f);
+  }
 
 
   nvgFontSize(vg, fontsize);
@@ -367,6 +382,9 @@ void OSDNanovgDisplayMessage(OSDMessage_struct * message, pixel_t * buffer, int
     nvgText(vg, LeftX, TxtY, message->message, NULL);
   }
 
+  if (rotate90) {
+    nvgRestore(vg);
+  }
   nvgEndFrame(vg);
 
 }
